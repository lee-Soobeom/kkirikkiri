<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.lsb.kkirikkiri.mappers.FileMapper">
    <insert id="insert">
        INSERT INTO `kkirikkiri`.`files` (`user_id`,
                                          `article_id`,
                                          `original_filename`,
                                          `saved_filename`,
                                          `saved_filepath`,
                                          `size`)
        VALUES (#{file.userId},
                #{file.articleId},
                #{file.originalFilename},
                #{file.savedFilename},
                #{file.savedFilepath},
                #{file.size})
    </insert>
</mapper>